{
  "name": "@repo/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run check:parity && eve build",
    "dev": "node --env-file-if-exists=.env.local node_modules/.bin/eve dev",
    "info": "bun run check:parity && node --env-file-if-exists=.env.local node_modules/.bin/eve info",
    "start": "eve start",
    "typecheck": "bun run check:parity && tsc --noEmit",
    "check:parity": "bun scripts/check-feature-parity.ts && bun run check:serialization",
    "check:serialization": "bun scripts/check-serialization-boundaries.ts",
    "parity:update": "bun scripts/check-feature-parity.ts --write && oxfmt feature-parity.json",
    "test": "bun run check:parity && bun test",
    "test:skills:lifecycle": "bun scripts/test-native-skill-lifecycle.ts"
  },
  "dependencies": {
    "@figma/rest-api-spec": "0.37.0",
    "@libsql/client": "0.17.4",
    "@linear/sdk": "82.1.0",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@notionhq/client": "5.20.0",
    "@octokit/auth-app": "8.2.0",
    "@rayhanadev/verdex": "0.2.0",
    "@repo/shared": "workspace:*",
    "@sentry/api": "0.113.0",
    "@sentry/node": "10.69.0",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/connect": "^0.6.1",
    "@vercel/sdk": "1.19.40",
    "ai": "^7.0.55",
    "croner": "9.1.0",
    "drizzle-orm": "0.45.2",
    "eve": "^0.29.5",
    "octokit": "5.0.5",
    "resend": "6.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "7.0.2"
  }
}
