        "FIGMA_TEAM_ID",
        "GITHUB_APP_ID",
        "GITHUB_APP_INSTALLATION_ID",
        "GITHUB_APP_PRIVATE_KEY",
        "GITHUB_ORG",
        "GLOBAL_CONFIG",
        "GROQ_API_KEY",
        "HCB_ORG_SLUG",
        "HUNTER_API_KEY",
        "KV_REST_API_READ_ONLY_TOKEN",
