        "SENTRY_VERCEL_LOG_DRAIN_URL",
        "SERPAPI_API_KEY",
        "SHIP_API_KEY",
        "SKIP_ENV_VALIDATION",
        "TURSO_AUTH_TOKEN",
        "TURSO_DATABASE_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "VERCEL_API_TOKEN",
        "VERCEL_PROJECT_ID",
        "VERCEL_TEAM_ID",
        "VERCEL_TOKEN"
