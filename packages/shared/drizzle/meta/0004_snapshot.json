          "value": "(\"scheduled_tasks\".\"schedule_type\" = 'once' AND \"scheduled_tasks\".\"cron\" IS NULL AND \"scheduled_tasks\".\"timezone\" IS NULL) OR (\"scheduled_tasks\".\"schedule_type\" = 'recurring' AND \"scheduled_tasks\".\"cron\" IS NOT NULL AND \"scheduled_tasks\".\"timezone\" IS NOT NULL)"
        },
