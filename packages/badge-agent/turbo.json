{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".output/**", ".vercel/output/**"],
      "env": [
        "AGENT_INGRESS_SECRET",
        "BOT_INGRESS_SECRET",
        "BOT_URL",
        "BADGES_CHANNEL_ID",
        "BADGES_API_URL",
        "BADGES_API_SECRET",
        "AI_GATEWAY_API_KEY",
        "SKIP_ENV_VALIDATION"
      ]
    }
  }
}
