{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // Hard project requirements. No `any`, no unchecked assertions, no `null`
    // in our own code, and every invariant explicit. An exception must be an
    // inline `oxlint-disable-next-line <rule> -- <why>`, so it is documented
    // at the site rather than waived wholesale in this file.
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "unicorn/no-null": "error",

    "oxclippy/needless-bool": "warn",
    "oxclippy/collapsible-if": "warn",
    "oxclippy/neg-multiply": "warn",
    "oxclippy/bool-comparison": "warn",
    "oxclippy/single-case-switch": "warn",
    "oxclippy/let-and-return": "warn",
    "oxclippy/int-plus-one": "warn",
    "oxclippy/needless-late-init": "warn",
    "oxclippy/identity-op": "warn",
    "oxclippy/manual-clamp": "warn",
    "oxclippy/manual-strip": "warn",
    "oxclippy/useless-conversion": "warn",
    "oxclippy/manual-swap": "warn",
    "oxclippy/manual-is-finite": "warn",
    "oxclippy/float-comparison": "warn",
    "oxclippy/xor-used-as-pow": "warn",
    "oxclippy/almost-swapped": "warn",
    "oxclippy/if-same-then-else": "warn",
    "oxclippy/never-loop": "warn",
    "oxclippy/float-equality-without-abs": "warn",
    "oxclippy/zero-divided-by-zero": "warn",
    "oxclippy/filter-then-first": "warn",
    "oxclippy/map-void-return": "warn",
    "oxclippy/map-identity": "warn",
    "oxclippy/manual-find": "warn",
    "oxclippy/manual-some": "warn",
    "oxclippy/manual-every": "warn",
    "oxclippy/manual-includes": "warn",
    "oxclippy/search-is-some": "warn",
    "oxclippy/needless-range-loop": "warn",
    "oxclippy/redundant-closure-call": "warn",
    "oxclippy/explicit-counter-loop": "warn",
    "oxclippy/unnecessary-fold": "warn",
    "oxclippy/single-element-loop": "warn",
    "oxclippy/too-many-arguments": "warn",
    "oxclippy/too-many-lines": "warn",
    "oxclippy/cognitive-complexity": "warn",
    "oxclippy/excessive-nesting": "warn",
    "oxclippy/fn-params-excessive-bools": "warn",
    "oxclippy/redundant-closure": "warn",
    "oxclippy/unnecessary-reduce-collect": "warn",
    "oxclippy/prefer-structured-clone": "warn",
    "oxclippy/object-keys-values": "warn",
    "oxclippy/promise-new-resolve": "warn",
    "oxclippy/similar-names": "warn",
    "oxclippy/match-same-arms": "warn",
    "oxclippy/used-underscore-binding": "warn",
    "oxclippy/needless-continue": "warn",
    "oxclippy/enum-variant-names": "warn",
    "oxclippy/struct-field-names": "warn",
    "oxclippy/unreadable-literal": "warn",
    "oxclippy/bool-to-int-with-if": "warn",
    "rayhanadev/no-type-erasure": "error",
    "rayhanadev/no-typeof": "error",
    "rayhanadev/cross-field-issue-without-path": "error",
    "rayhanadev/json-parse-argument-of-safeparse": "error",
    "rayhanadev/number-int-method": "error",
    "rayhanadev/object-strict-method": "error",
    "rayhanadev/optional-default-redundant": "error",
    "rayhanadev/record-string-unknown": "error",
    "rayhanadev/shape-spread-drops-refinements": "error",
    "rayhanadev/throwing-zod-refine": "error",
    "rayhanadev/tool-input-integer-as-number": "error",
    "rayhanadev/tool-input-not-strict": "error",
    "rayhanadev/trim-after-string-constraint": "error",
    "rayhanadev/union-of-literals-to-literal-array": "error",
    "rayhanadev/zinfer-instead-of-zoutput": "error",
    "rayhanadev/zod3-string-format-method": "error",
    "rayhanadev/zodtype-annotation-instead-of-satisfies": "error",
    "rayhanadev/zodtype-t-generic-helper": "error",
    "rayhanadev/comment-explains-why": "warn",
    // Merged by `ox`, and still being adopted. A rule sits at "off" here only
    // while the code does not satisfy it, with the violation count it arrived
    // with, so the remaining work is visible rather than absent. Each one moves
    // to its real severity in the commit that clears it.
    //
    // This is the one place the project's "never waive a rule wholesale" rule
    // bends, and only for rules that were never on.
    //
    //   comment style        1,187   CLEARED — enabled below
    //   Result adoption        695   no-throw, no-try-catch, no-promise-catch,
    //                                no-error-sentinel, wrap-throwing-api,
    //                                require-tagged-error
    //   type discipline        309   no-conditional-empty-object-spread (262),
    //                                no-known-value-widening, no-zod-type-erasure,
    //                                no-json-parse-stringify-codec,
    //                                no-chained-type-assertions
    //   file organization       99   constants/errors/enum/types
    //   suppressions            10   lint-suppression-requires-reason
    "rayhanadev/comment-ste100": "error",
    "rayhanadev/comment-ste100-heuristics": "warn",
    "rayhanadev/commented-out-code-requires-reason": "error",
    "rayhanadev/complex-file-header": "warn",
    "rayhanadev/constants-file-organization": "error",
    "rayhanadev/domain-knowledge-in-agents": "error",
    "rayhanadev/enum-file-organization": "error",
    "rayhanadev/errors-file-organization": "error",
    "rayhanadev/filename-match-export": "error",
    "rayhanadev/lint-suppression-requires-reason": "error",
    "rayhanadev/no-ad-hoc-result": "error",
    "rayhanadev/no-async-result-try": "error",
    "rayhanadev/no-chained-type-assertions": "error",
    "rayhanadev/no-conditional-empty-object-spread": "error",
    "rayhanadev/no-error-sentinel": "off",
    "rayhanadev/no-exported-function-expressions": "error",
    "rayhanadev/no-json-parse-stringify-codec": "error",
    "rayhanadev/no-known-value-widening": "error",
    "rayhanadev/no-promise-catch": "off",
    "rayhanadev/no-promise-reject": "error",
    "rayhanadev/no-result-unwrap": "error",
    "rayhanadev/no-throw": "off",
    "rayhanadev/no-try-catch": "off",
    "rayhanadev/no-unknown-type-aliases": "error",
    "rayhanadev/no-unsafe-dictionary-type": "error",
    "rayhanadev/no-widen-then-assert": "error",
    "rayhanadev/no-zod-type-erasure": "off",
    "rayhanadev/prefer-result-await": "error",
    "rayhanadev/require-jsdoc-comments": "error",
    "rayhanadev/require-result-gen-return": "error",
    "rayhanadev/require-tagged-error": "off",
    "rayhanadev/schemas-file-organization": "error",
    "rayhanadev/types-file-organization": "error",
    "rayhanadev/wrap-throwing-api": "off"
  },
  "env": {
    "builtin": true
  },
  "jsPlugins": [
    "oxclippy",
    {
      "name": "rayhanadev",
      "specifier": "@rayhanadev/ox"
    }
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error"
  }
}
