# Build context hygiene. Without this the legacy tree and every node_modules
# directory get uploaded to the daemon on each build.
node_modules
**/node_modules
old
.git
.turbo
.eve
.vercel
coverage
*.log
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Eve apps are built separately from the gateway image.
**/.output
**/.eve
