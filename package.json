{
  "name": "wack-hacker-monorepo",
  "description": "A Discord bot that helps run Purdue Hackers!",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "start": "turbo start",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "validate": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "turbo": "^2.10.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxclippy": "^0.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.3.14"
    }
  }
}
