{
  "name": "wack-hacker-monorepo",
  "private": true,
  "description": "A Discord bot that helps run Purdue Hackers!",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "start": "turbo start",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt",
    "validate": "bun run format:check && bun run typecheck && bun run lint && bun run test",
    "format:check": "oxfmt --check .",
    "audit": "bun audit --ignore GHSA-67mh-4wv8-2f99",
    "test": "turbo test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxclippy": "^0.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.8",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.3.14"
    }
  },
  "packageManager": "bun@1.3.14"
}
