# Wack Hacker environment
#
# The validated schemas live in packages/bot/src/env.ts and
# packages/agents/agent/lib/env.ts, and each declares only what its package
# currently reads. This file is the complete map, including variables whose
# feature has not landed yet, grouped by what still needs wiring, so nothing
# arrives as a surprise.
#
# The legacy app's .env.example had drifted eight variables behind its own
# schema (EDGE_CONFIG, FIGMA_ACCESS_TOKEN, FIGMA_TEAM_ID, HCB_ORG_SLUG,
# SENTRY_AUTH_TOKEN, SENTRY_DSN, SENTRY_ORG, SANDBOX_BASE_SNAPSHOT_ID) and read
# SENTRY_PROJECT without declaring it anywhere. All nine are below.
#
# Set SKIP_ENV_VALIDATION=1 to load a package without credentials.

# ─── The seam ────────────────────────────────────────────────────────────────
# Two directions, two secrets: a leaked inbound bearer must not also grant the
# ability to impersonate the agent calling back.
AGENT_URL=https://your-agent.vercel.app
AGENT_INGRESS_SECRET=
BOT_URL=http://127.0.0.1:8080
BOT_INGRESS_SECRET=

# ─── Discord ─────────────────────────────────────────────────────────────────
# Both packages need the token: the bot for the gateway and community features,
# the agent because it renders agent replies itself.
# The guild id is a compile-time constant in @repo/shared/discord, not env.
DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENT_ID=

# ─── Storage ─────────────────────────────────────────────────────────────────
# Redis: bot (dedup, per-key locks, pending-turn queue, hack-night threads) and
# agent (daily token budgets, turn→message index for feedback reactions).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Turso: agent only. The bot writes no durable rows.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Bot process ─────────────────────────────────────────────────────────────
# Health endpoint. Serves the Vercel Sandbox supervisor and any other host's
# liveness probe equally.
PORT=8080

# ─── Community features (bot) ────────────────────────────────────────────────
# `/hack-night` bumps the dashboard's Edge Config version key.
VERCEL_API_TOKEN=
DASHBOARD_EDGE_CONFIG=
# The hack night photo archive, read by the Sunday cleanup job.
PAYLOAD_CMS_API_KEY=
# `/privacy`, backed by pdb.purduehackers.com.
PRIVACY_DB_API_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
# Build-time only, for source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Not yet wired: remaining community features ─────────────────────────────
# Voice-message transcription (Groq whisper-large-v3).
GROQ_API_KEY=
# Dashboard mirroring at api.purduehackers.com.
PHACK_API_TOKEN=
# Ship submissions at ships.purduehackers.com.
SHIP_API_KEY=

# ─── Phase 4: agent domains ──────────────────────────────────────────────────
# Organizer roster, read by resolve_organizer.
EDGE_CONFIG=

LINEAR_API_KEY=
NOTION_TOKEN=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=purduehackers

FIGMA_ACCESS_TOKEN=
FIGMA_TEAM_ID=

HCB_ORG_SLUG=

# Amazon product search for the shopping domain.
SERPAPI_API_KEY=
# Web search.
EXA_API_KEY=
# Internal knowledge base at ask.purduehackers.com.
PHACK_ASK_API_KEY=

# Outreach domain.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
HUNTER_API_KEY=

# ─── Phase 7: bot hosting on Vercel Sandbox (agent-side supervisor) ──────────
# Only needed if the bot runs on Vercel Sandbox rather than Fly/Railway/homelab.
# The supervisor authenticates with project OIDC on Vercel; set a token only
# when running it from outside Vercel.
VERCEL_TOKEN=
