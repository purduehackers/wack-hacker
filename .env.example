# Wack Hacker environment — the complete map.
#
# Copy the parts you need into a PER-PACKAGE file:
#
#   packages/bot/.env.local
#   packages/agents/.env.local
#
# Not the repo root. Bun reads .env files from the working directory and does
# not walk up, and both `turbo dev` and the eve CLI run from the package
# directory — a root .env.local is silently invisible to them.
#
# Both packages need the same pair of bearer values, but the two values must be
# different: AGENT_INGRESS_SECRET authenticates bot→agent, while
# BOT_INGRESS_SECRET authenticates agent→bot. Generate each independently with
# `openssl rand -hex 32`.
#
# The validated schemas live in packages/bot/src/env.ts and
# packages/agents/agent/env.ts, and each declares only what its package reads.
# Anything absent from both schemas is read by tooling rather than the app.
#
# Set to 1 only for credential-free compile tooling.
SKIP_ENV_VALIDATION=
# Must be present before either OTel SDK initializes.
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=65536

# ─── The seam ────────────────────────────────────────────────────────────────
# Two directions, two secrets: a leaked inbound bearer must not also grant the
# ability to impersonate the agent calling back.
AGENT_URL=https://your-agent.vercel.app
AGENT_INGRESS_SECRET=
# Static-host fallback. With Sandbox, agent calls resolve the fenced active Redis generation.
BOT_URL=http://127.0.0.1:8080
BOT_INGRESS_SECRET=

# ─── Discord ─────────────────────────────────────────────────────────────────
# Three readers, one token: the bot runtime (gateway + rendering the agent's
# replies), the agent's Discord domain tools (@discordjs/rest, bounded by the
# shared policy runtime), and the bot-supervisor schedule, which injects it into
# the bot container it starts. Treat a leak as full bot compromise.
# The guild id is a compile-time constant in @repo/shared/discord, not env.
DISCORD_BOT_TOKEN=
DISCORD_BOT_CLIENT_ID=

# ─── Storage ─────────────────────────────────────────────────────────────────
# Redis: bot (dedup, delivery/render coordination, hack-night threads) and
# agent (durable render intent, token budgets, tools, and schedules).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Turso: agent only. The bot writes no durable rows.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Bot process ─────────────────────────────────────────────────────────────
# Health endpoint. Serves the Vercel Sandbox supervisor and any other host's
# liveness probe equally.
PORT=8080

# ─── Community features and CMS ─────────────────────────────────────────────
# `/hack-night` bumps the dashboard's Global Config version key.
VERCEL_API_TOKEN=
DASHBOARD_GLOBAL_CONFIG=
# Cloudflare DNS, Email Routing, and transactional sending.
# Token needs: Zone:DNS:Edit, Zone:Zone:Read, Zone:Email Routing:Edit,
# Account:Email Sending:Read+Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# The bot uses this for hack-night photos; the Eve CMS specialist uses it for Payload content.
PAYLOAD_CMS_API_KEY=
# Mirroring #ship posts to the public gallery.
SHIP_API_KEY=
# Mirroring public messages to the dashboard.
PHACK_API_TOKEN=
# Voice-message transcription (Groq whisper-large-v3-turbo).
GROQ_API_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
# Runtime credentials for the agent's `sentry` domain, not just build tooling —
# without them its 68 tools fail at execution rather than being hidden.
SENTRY_ORG=
SENTRY_AUTH_TOKEN=
# Sentry subagent tools: user token with event:read and org:read.
SENTRY_API_TOKEN=

# ─── Agent provider domains ──────────────────────────────────────────────────
# One block per subagent under packages/agents/agent/subagents/. A missing
# credential is not a hidden capability: the domain still appears and its tools
# fail with a typed 401 naming the key, which is what `requires` on each tool
# declares. See each domain's AGENTS.md.
#
# Organizer roster, read by resolve_organizer.
GLOBAL_CONFIG=

LINEAR_API_KEY=
# Notion backs both the `notion` domain and the outreach CRM.
NOTION_TOKEN=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=purduehackers

FIGMA_ACCESS_TOKEN=
FIGMA_TEAM_ID=

# Hack Club Bank, for the finance domain. No API key — only organizations in
# Transparency Mode are visible at all.
HCB_ORG_SLUG=

# Amazon product search for the shopping domain.
SERPAPI_API_KEY=
# Web search.
EXA_API_KEY=
# Internal knowledge base at ask.purduehackers.com.
PHACK_ASK_API_KEY=

# Outreach: finding and verifying addresses. The send itself goes through
# CLOUDFLARE_API_TOKEN above.
HUNTER_API_KEY=

# ─── Bot Sandbox supervision (agent deployment) ───────────────────────────────
# Read only by agent/schedules/bot-supervisor.ts, which injects them into the
# bot container it starts. Reasoning and domain tools never see them. Keep
# disabled until BOT_IMAGE and every bot runtime credential above are present;
# enabled-but-incomplete fails the reconcile rather than starting a broken bot.
BOT_SANDBOX_ENABLED=false
# Immutable VCR digest, never a mutable latest tag.
BOT_IMAGE=
# Sandbox API credentials. Omit all three on Vercel to use project OIDC; a
# partial set is rejected.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
